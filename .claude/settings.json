{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bunx ultracite fix --skip=correctness/noUnusedImports --hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "firebase@anthropic-plugin-directory": true
  }
}

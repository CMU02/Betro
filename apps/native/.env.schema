# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
EXPO_PUBLIC_SERVER_URL=

# Sentry 오류 수집 주소. 비우면 Sentry를 켜지 않고 앱은 그대로 동작한다.
# @public @optional @type=url
EXPO_PUBLIC_SENTRY_DSN=

# NCP Maps Application의 Client ID. app.config.ts가 네이버 지도 SDK 설정(Info.plist, AndroidManifest)에 넣는다.
# 앱 바이너리에 그대로 들어가는 공개 값이다. Client Secret은 앱에 두지 않는다.
# @public
NAVER_MAP_CLIENT_ID=

# --- 아래는 빌드 도구(sentry-cli)만 읽는다. JS 코드에서 참조하지 않으며 번들에 들어가지 않는다. ---

# Sentry 조직 슬러그(소스맵 업로드용).
# @optional
SENTRY_ORG=

# Sentry 프로젝트 슬러그(소스맵 업로드용).
# @optional
SENTRY_PROJECT=

# 소스맵·디버그 심볼 업로드 토큰. 없으면 release 빌드가 업로드를 건너뛴다.
# @optional @sensitive
SENTRY_AUTH_TOKEN=

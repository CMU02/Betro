<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android 16 Live Update(상단 고정 진행 중 알림). 런타임 권한이 아니다. -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

  <application>
    <receiver
      android:name="expo.modules.commutenotification.CommuteActionReceiver"
      android:exported="false" />
    <!-- 진행 중 알림의 타이머가 끝나면 타이머 없이 "곧"으로 다시 그린다. -->
    <receiver
      android:name="expo.modules.commutenotification.CountdownEndReceiver"
      android:exported="false" />
    <service
      android:name="expo.modules.commutenotification.CommuteActionTaskService"
      android:exported="false" />
  </application>
</manifest>
